# Скопируйте в .env.local и заполните.

# PostgreSQL (Neon, Supabase или свой сервер). Без неё локально используется PGlite в папке .data/.
# На хостинге (Vercel) обязательна.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Прямое подключение без пула (для создания таблиц при старте). Neon через Vercel задаёт его сам.
# Если не задано — используется DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/dbname?sslmode=require

# Дополнительные адреса сайта, с которых разрешены формы (через запятую), если сайт открыт по нескольким доменам.
# ALLOWED_ORIGINS=https://bliss.example

# Пароль владельца для входа в кабинет /admin (не короче 8 символов).
# Действует, пока пароль не сменили в кабинете («Доступ»); дальше в базе хранится только его хэш.
# В режиме разработки (npm run dev) без этой переменной пароль — bliss-demo.
# ADMIN_PASSWORD=
