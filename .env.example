# Скопируйте в .env.local и заполните.

# PostgreSQL (Neon, Supabase или свой сервер). Без неё локально используется PGlite в папке .data/.
# На хостинге (Vercel) обязательна.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Дополнительные адреса сайта, с которых разрешены формы (через запятую), если сайт открыт по нескольким доменам.
# ALLOWED_ORIGINS=https://bliss.example
